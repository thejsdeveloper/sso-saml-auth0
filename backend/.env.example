# Copy to .env and fill in. .env is git-ignored.

PORT=3000
# Public base URL of this app. Must match the URLs configured in the Auth0 SAML addon.
APP_BASE_URL=http://localhost:3000
# Only for frontend dev mode (Vite on :5173). Leave unset when the backend serves frontend/dist.
# FRONTEND_URL=http://localhost:5173

# --- Service Provider (us) ---
SP_ENTITY_ID=urn:sso-saml-demo:sp

# --- Identity Provider (Auth0) --- values from Auth0 > Application > Addons > SAML2 > Usage
IDP_ENTRY_POINT=https://YOUR_TENANT.us.auth0.com/samlp/YOUR_CLIENT_ID
IDP_ISSUER=urn:YOUR_TENANT.us.auth0.com
# Auth0's public signing certificate (download from https://YOUR_TENANT.us.auth0.com/pem)
IDP_CERT_PATH=./certs/auth0-idp.pem

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change-me
